{
  "extends": "../../tsconfig.base.json",
  "include": [
    "pages/**/*",
    "lib/**/*",
    "styles/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "src"
  ],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "allowJs": true,
    "strict": false,
    "incremental": true,
    "esModuleInterop": true
  }
}
